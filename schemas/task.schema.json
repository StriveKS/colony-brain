{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/StriveKS/colony-brain/schemas/task.schema.json",
  "title": "COLONIA Task",
  "type": "object",
  "required": ["task_id", "environment", "objective", "required_skills", "recommended_skills", "min_skill_count", "max_skill_count", "fitness_policy", "success_criteria", "stop_criteria"],
  "properties": {
    "task_id": {"type": "string"},
    "environment": {"type": "string"},
    "objective": {"type": "string"},
    "barriers_expected": {"type": "array", "items": {"type": "string"}},
    "required_skills": {"type": "array", "items": {"type": "string"}},
    "recommended_skills": {"type": "array", "items": {"type": "string"}},
    "min_skill_count": {"type": "integer", "minimum": 0},
    "max_skill_count": {"type": "integer", "minimum": 1},
    "fitness_policy": {"type": "string"},
    "success_criteria": {"type": "array", "items": {"type": "string"}},
    "stop_criteria": {"type": "array", "items": {"type": "string"}},
    "inputs": {"type": "object"},
    "created_at": {"type": "string"},
    "updated_at": {"type": "string"}
  }
}
