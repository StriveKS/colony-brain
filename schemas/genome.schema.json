{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/StriveKS/colony-brain/schemas/genome.schema.json",
  "title": "COLONIA Genome",
  "type": "object",
  "required": ["genome_id", "version", "environment", "genes"],
  "properties": {
    "genome_id": {"type": "string"},
    "version": {"type": "string"},
    "environment": {"type": "string"},
    "parent_ids": {"type": "array", "items": {"type": "string"}},
    "generation": {"type": "integer"},
    "genes": {"type": "object"},
    "skills_manifest": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["skill_id", "version"],
        "properties": {
          "skill_id": {"type": "string"},
          "version": {"type": "string"},
          "status": {"type": "string"}
        }
      }
    },
    "fitness_summary": {
      "type": "object",
      "properties": {
        "best_fitness": {"type": "number"},
        "average_fitness": {"type": "number"},
        "sample_size": {"type": "integer"}
      }
    },
    "created_at": {"type": "string"},
    "updated_at": {"type": "string"}
  }
}
